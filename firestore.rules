rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    function ehBarbeiro() {
      return logado() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tipo == 'barbeiro';
    }

    // Agendamento como ficará depois da gravação atual (usado para conferir o ocupado).
    function agendamentoDe(id) {
      return getAfter(/databases/$(database)/documents/appointments/$(id)).data;
    }

    match /users/{uid} {
      allow read: if logado() && (request.auth.uid == uid || ehBarbeiro());
      allow create: if logado() && request.auth.uid == uid
                    && request.resource.data.tipo == 'cliente';
      allow update: if logado() && request.auth.uid == uid
                    && request.resource.data.tipo == resource.data.tipo;
    }

    match /services/{id} {
      allow read: if logado();
      allow write: if false;
    }

    match /configuracao/{id} {
      allow read: if logado();
      allow write: if false;
    }

    match /appointments/{id} {
      // O calendário lê o status de agendamentos de outros usuários para
      // saber se um horário foi cancelado. Por isso o get é aberto a logados.
      allow get: if logado();

      allow list: if logado()
                  && (resource.data.userId == request.auth.uid || ehBarbeiro());

      allow create: if logado()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'confirmado';

      allow update: if logado() && (
          // cancelar o próprio agendamento
          (resource.data.userId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status == 'cancelado')
          ||
          // reaproveitar um horário que estava cancelado
          (resource.data.status == 'cancelado'
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.status == 'confirmado'
            && request.resource.data.data == resource.data.data
            && request.resource.data.horaInicio == resource.data.horaInicio
            && request.resource.data.barbeiroId == resource.data.barbeiroId)
        );
    }

    match /ocupados/{id} {
      allow read: if logado();

      // Só cria o ocupado se o agendamento do próprio usuário for gravado
      // junto, com os mesmos dados, e com apenas os três campos esperados.
      allow create: if logado()
                    && request.resource.data.keys().hasOnly(['barbeiroId', 'data', 'horaInicio'])
                    && agendamentoDe(id).userId == request.auth.uid
                    && agendamentoDe(id).status == 'confirmado'
                    && agendamentoDe(id).barbeiroId == request.resource.data.barbeiroId
                    && agendamentoDe(id).data == request.resource.data.data
                    && agendamentoDe(id).horaInicio == request.resource.data.horaInicio;
    }
  }
}